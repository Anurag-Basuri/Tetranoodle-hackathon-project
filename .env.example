# ScholarPilot AI - Environment Configuration

# Application
ENV=dev
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173

# Database (PostgreSQL for production/Render; SQLite for local test)
# Local SQLite default:
DATABASE_URL=sqlite+aiosqlite:///./scholarpilot.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://scholar:secret@localhost:5432/scholarpilot

# LLM Providers (Configure at least Gemini or Groq)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Search Providers (Tavily is primary, Brave is optional fallback)
TAVILY_API_KEY=
BRAVE_API_KEY=

# GitHub API (Optional: raises rate limits from 60/hr to 5000/hr)
GITHUB_TOKEN=

# Concurrency & Guardrails
MIN_CANDIDATES=12
MAX_CANDIDATES=18
FETCH_CONCURRENCY=3
LLM_CONCURRENCY=2
MAX_LLM_CALLS_PER_JOB=120
JOB_TIMEOUT_S=720
AGENT_TIMEOUT_S=90
