# ScholarPilot AI - Backend Environment Template for Render
# Copy and configure these in the Render Dashboard Environment settings

# Environment mode
ENV=production
LOG_LEVEL=INFO

# Allowed Frontend Origins (Vercel domain or comma-separated domains)
FRONTEND_ORIGIN=https://scholarpilot.vercel.app

# Database URL (Neon PostgreSQL connection string)
# Format: postgresql+asyncpg://<user>:<password>@<neon-endpoint>.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require

# LLM API Keys (At least GEMINI_API_KEY is required)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# Search Providers (At least TAVILY_API_KEY is required)
TAVILY_API_KEY=YOUR_TAVILY_API_KEY
BRAVE_API_KEY=YOUR_BRAVE_API_KEY

# Optional GitHub Personal Access Token (for enriched rate limits)
GITHUB_TOKEN=

# Pipeline Performance Limits
MIN_CANDIDATES=12
MAX_CANDIDATES=18
FETCH_CONCURRENCY=3
LLM_CONCURRENCY=2
MAX_LLM_CALLS_PER_JOB=120
JOB_TIMEOUT_S=720
AGENT_TIMEOUT_S=90
